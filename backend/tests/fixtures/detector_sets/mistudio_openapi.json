{
 "components": {
  "schemas": {
   "DatasetDownloadRequest": {
    "description": "Schema for HuggingFace dataset download request.",
    "properties": {
     "access_token": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "HuggingFace access token for gated datasets",
      "title": "Access Token"
     },
     "config": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Dataset configuration name (e.g., 'en', 'zh') for datasets with multiple configs",
      "title": "Config"
     },
     "repo_id": {
      "description": "HuggingFace repository ID (e.g., 'roneneldan/TinyStories')",
      "minLength": 1,
      "title": "Repo Id",
      "type": "string"
     },
     "split": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Dataset split to download (e.g., 'train', 'validation', 'test')",
      "title": "Split"
     }
    },
    "required": [
     "repo_id"
    ],
    "title": "DatasetDownloadRequest",
    "type": "object"
   },
   "ProbeDatasetCreate": {
    "additionalProperties": false,
    "properties": {
     "config": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Config"
     },
     "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
     },
     "distribution": {
      "anyOf": [
       {
        "enum": [
         "in_distribution",
         "out_of_distribution"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Distribution"
     },
     "input_column": {
      "minLength": 1,
      "title": "Input Column",
      "type": "string"
     },
     "keyword_filter": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/KeywordFilterSpec"
       },
       {
        "type": "null"
       }
      ]
     },
     "label_column": {
      "minLength": 1,
      "title": "Label Column",
      "type": "string"
     },
     "label_mapping": {
      "additionalProperties": {
       "enum": [
        "positive",
        "negative",
        "excluded"
       ],
       "type": "string"
      },
      "title": "Label Mapping",
      "type": "object"
     },
     "name": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Name",
      "type": "string"
     },
     "pair_column": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Pair Column"
     },
     "role": {
      "default": "eval",
      "enum": [
       "train",
       "eval",
       "calibration"
      ],
      "title": "Role",
      "type": "string"
     },
     "split": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Split"
     }
    },
    "required": [
     "name",
     "dataset_id",
     "input_column",
     "label_column",
     "label_mapping"
    ],
    "title": "ProbeDatasetCreate",
    "type": "object"
   }
  }
 },
