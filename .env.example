# miDataworks backend configuration. Copy to .env (git-ignored) and fill in. Every variable that
# backend/src/core/config.py reads is listed here; tests/unit/test_config.py checks the two agree.
# In Kubernetes these come from the manifest and Secrets, never from a tracked file (ADR-015).

# --- required ---------------------------------------------------------------------------------
# Async SQLAlchemy URL. The worker/Alembic sync URL is derived from it (+psycopg2).
DATABASE_URL=postgresql+asyncpg://midataworks:midataworks-dev@127.0.0.1:55433/midataworks
# Celery broker and result backend.
REDIS_URL=redis://127.0.0.1:56380/0
# At least 32 characters. Losing it loses every stored secret; back it up with the cluster secrets.
SETTINGS_ENCRYPTION_KEY=
# Shared secret between workers and the API's internal emit route.
INTERNAL_API_SECRET=

# --- optional (defaults shown) ----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DATA_DIR=/data/dataworks
# Optional siblings: leave either unset and miDataworks runs standalone. miLLM: health, and the
# probe-verdict and feature-tag label runs. miStudio: health, and the detector-set send, results
# refresh and reward marks, which refuse with mistudio_not_configured while it is unset.
MILLM_BASE_URL=
MISTUDIO_BASE_URL=
# Where workers reach the API (for the internal emit route).
DATAWORKS_API_URL=http://localhost:8000
PROGRESS_HEARTBEAT_SECONDS=60
HEALTH_PROBE_TIMEOUT_SECONDS=2
APPROVAL_TTL_HOURS=24
AGENT_LABEL_ROW_THRESHOLD=5000
AGENT_LABEL_WINDOW_HOURS=24
# Feature 010 (MCP). Read by the API for the Settings screen's Agent access card only.
MCP_PUBLIC_URL=
MCP_INTERNAL_URL=
AGENT_REQUEST_RETENTION_DAYS=30
# The MCP server itself (python -m src.mcp_server) reads only these; it has no database or Redis.
# MCP_AUTH_TOKEN=            # required on HTTP; one shared token (P-12)
# MCP_AGENT_IDENTITY=agent:dataworks-mcp
# MCP_TOOL_CATEGORIES=calibration,core,curation,datasets,detector_sets,exports,generation,labeling,operators,review,settings
JANITOR_INTERVAL_SECONDS=120
# Feature 002 (versions, recipes and provenance).
VERSION_BUILD_JANITOR_MINUTES=30
ROW_EVENT_COPY_CHUNK=50000
PARQUET_ROW_GROUP_ROWS=100000
ROW_HISTORY_TEXT_MATCHES=50
ORPHAN_SWEEP_AGE_MINUTES=60
# Feature 001 (sources and import).
HF_HUB_URL=https://huggingface.co
HF_DATASETS_SERVER_URL=https://datasets-server.huggingface.co
HF_HTTP_TIMEOUT_S=30
PREVIEW_TIMEOUT_S=30
EPHEMERAL_SECRET_TTL_S=900
SOURCE_IMPORT_JANITOR_LIMIT_S=900
UPLOAD_MAX_BYTES=2147483648
IMPORT_CONFIRM_BYTES=50000000000
# Feature 008 (publishing, export and handoff contract).
PUBLISH_DEFAULT_NAMESPACE=
# The Hub's recommended per-file size (<200GB); its hard limit is 500GB (storage-limits doc).
PUBLISH_MAX_FILE_BYTES=200000000000
PUBLISH_HUB_RETRIES=5
PUBLISH_HUB_BACKOFF_S=2
PUBLISH_JANITOR_LIMIT_SECONDS=1800
PUBLISH_BUILD_BATCH_ROWS=65536
REWARD_BUNDLE_TRL_VERSION=1.14.1
# The image commit recorded as producer.build in every handoff manifest (CI sets it).
APP_BUILD=dev
# Tests only: run Celery tasks in-process. Never set in a deployment.
CELERY_TASK_ALWAYS_EAGER=false
# Feature 006: calibration and review (FTID 006 section 9).
CALIBRATION_MAX_PER_RATER_ROWS=200000
REVIEW_CANDIDATE_MAX_BYTES=65536
# Feature 009: detector sets and the miStudio loop (FTID 009 section 9).
DETECTOR_SEND_POLL_SECONDS=10
DETECTOR_SEND_DOWNLOAD_TIMEOUT_MINUTES=60
DETECTOR_SEND_JANITOR_LIMIT_SECONDS=900
# D-5 tolerance, measured on the prototype's two calibration sets (009 FTASKS 1.3).
DETECTOR_LENGTH_OVERLAP_MIN=0.5
DETECTOR_CAPABILITY_TTL_SECONDS=600
MISTUDIO_TIMEOUT_SECONDS=30
# Feature 003: operators (FTDD 003 section 11.2)
OPERATOR_TEST_FIXTURES=false
OPERATOR_PREVIEW_SAMPLE_DEFAULT=300
OPERATOR_PREVIEW_SAMPLE_MAX=2000
OPERATOR_MODEL_PREVIEW_SAMPLE_DEFAULT=5
OPERATOR_MODEL_PREVIEW_SAMPLE_MAX=50
OPERATOR_BATCH_ROWS=10000
OPERATOR_PREVIEW_SYNC_WAIT_S=3
OPERATOR_PREVIEW_SOFT_LIMIT_S=60
OPERATOR_PREVIEW_HARD_LIMIT_S=90
OPERATOR_PREVIEW_RESULT_TTL_S=3600
OPERATOR_PARAMS_MAX_BYTES=65536
DATAJUICER_HEALTH_CACHE_S=30
DJ_NUM_PROC=
# Feature 004: curation (FTDD 004 section 11.2). The warning MARGIN is not an environment
# variable: it is data with history (Settings and each dataset's page) with a code default (P-19).
CURATION_INLINE_MAX_ROWS=20000
CURATION_AUDIT_FOLDS=5
CURATION_CONTROL_RUNS=5
CURATION_CONTROL_TOLERANCE_PP=2
CURATION_MINHASH_PERMUTATIONS=128
CURATION_EMBED_EXACT_MAX_ROWS=200000
CURATION_SWEEP_INTERVAL_S=60
CURATION_CELL_SAMPLE_SIZE=30
# Shared with the Data Designer worker only (ADR-010 amendment): seals model keys handed to it.
DESIGNER_HANDOFF_KEY=
# Feature 005: labeling and endpoints (FTDD 005 section 11)
LABEL_CHUNK_SIZE=200
LABEL_MAX_CONSECUTIVE_FAILURES=20
LABEL_BACKOFF_CAP_SECONDS=60
LABEL_TRANSIENT_RETRIES=3
JUDGE_PARSE_FAILURE_STOP_SHARE=0.05
JUDGE_PARSE_FAILURE_MIN_ROWS=200
KEEP_SHARE_SAMPLE_ROWS=400
KEEP_SHARE_MAX_ROWS=1000
LABEL_SAMPLE_MAX_ROWS=20
LABEL_SAMPLE_TIMEOUT_SECONDS=30
ENDPOINT_HTTP_TIMEOUT_SECONDS=120
MILLM_LEASE_TTL_SECONDS=1800
MILLM_LEASE_HOLDER=midataworks
LABEL_LEASE_RETRY_SECONDS=60
LABEL_BATCH_MAX_LINES=50000
LABEL_BATCH_POLL_SECONDS=5

# Feature 007: synthetic generation and steered pairs (FTDD 007 section 11)
# Prompts per committed chunk; preview caps (5 prompts, 60 s); upper bound on N.
GENERATION_CHUNK_SIZE=200
GENERATION_PREVIEW_MAX_PROMPTS=5
GENERATION_PREVIEW_TIMEOUT_SECONDS=60
GENERATION_MAX_N_RESPONSES=16
# native (EndpointCaller) or relay (007's operator on 003's loopback relay); set from 003's spike.
GENERATION_ENGINE_PATH=native
# true only once miLLM serves X-miLLM-Steering and inline steering (007 FTASKS 1.2).
MILLM_STEERING_SUPPORTED=true
# Diversity report: rows per side, bootstrap resamples, Beat sweep interval, lexical clusters.
DIVERSITY_SAMPLE_SIZE=5000
DIVERSITY_BOOTSTRAP_RESAMPLES=1000
DIVERSITY_SWEEP_SECONDS=300
DIVERSITY_CLUSTER_K=50

# --- docker-compose.yml (local PostgreSQL 15 and Redis 7) --------------------------------------
MIDATAWORKS_PG_PORT=55433
MIDATAWORKS_REDIS_PORT=56380
MIDATAWORKS_PG_PASSWORD=midataworks-dev
