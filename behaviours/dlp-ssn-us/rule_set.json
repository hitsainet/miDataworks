  "description": "Pilot: a US Social Security number that checks out under the issuance rules (area not 000, 666 or 900-999; group not 00; serial not 0000), cued by a nearby word; masked values vetoed per candidate. Number shapes read: three-two-four with dash, space or dot delimiters, and nine in a row; mask characters X, x, *, the bullet and #. Renderings a pattern cannot see are declared with their normalisers; decoys are look-alike numbers and named-but-absent values.",
  "expressions": {
    "cued": {
      "signal": "cue"
    },
    "is_masked": {
      "signal": "masked"
    },
    "valid_ssn": {
      "signal": "ssn"
    }
  },
  "format": "midataworks.rule-set/v1",
  "name": "dlp-ssn-us-elements",
  "outputs": [
    {
      "column": "ssn_hit",
      "type": "bool",
      "value": {
        "fired": "valid_ssn"
      }
    },
    {
      "column": "ssn_cued",
      "type": "bool",
      "value": {
        "fired": "cued"
      }
    },
    {
      "column": "ssn_reason",
      "type": "string",
      "value": {
        "field": [
          "ssn",
          "reason"
        ]
      }
    },
    {
      "column": "ssn_spans",
      "type": "string",
      "value": {
        "spans": "valid_ssn"
      }
    }
  ],
  "renderings": [
    {
      "invisible_to": [
        "num",
        "ssn"
      ],
      "normaliser": {
        "builtin": "strip_delimiters"
      },
      "render": {
        "builtin": "spaced"
      },
      "rendering": "spaced"
    },
    {
      "invisible_to": [
        "num",
        "ssn"
      ],
      "normaliser": {
        "builtin": "strip_delimiters"
      },
      "render": {
        "builtin": "split_lines"
      },
      "rendering": "split_lines"
    },
    {
      "invisible_to": [
        "num",
        "ssn"
      ],
      "normaliser": {
        "builtin": "words_to_digits"
      },
      "render": {
        "builtin": "spelled_out_digits"
      },
      "rendering": "spelled"
    },
    {
      "invisible_to": [
        "num",
        "ssn"
      ],
      "normaliser": {
        "mapping_inverse": true
      },
      "render": {
        "mapping": {
          "0": "0 ",
          "1": "one",
          "2": "2 ",
          "3": "three",
          "4": "4 ",
          "5": "five",
          "6": "6 ",
          "7": "seven",
          "8": "8 ",
          "9": "nine"
        }
      },
      "rendering": "mixed_words"
    },
    {
      "invisible_to": [
        "num",
        "ssn"
      ],
      "normaliser": {
        "mapping_inverse": true
      },
      "render": {
        "mapping": {
          "-": ", then "
        }
      },
      "rendering": "prose"
    }
  ],
  "signals": [
    {
      "fold_fullwidth_ascii": false,
      "id": "num",
      "ignore_case": false,
      "kind": "pattern",
      "pattern": "(?:\\b[0-9Xx]{3}|[*•#]{3})[- .][0-9Xx*•#]{2}[- .][0-9]{4}\\b|(?:\\b[0-9Xx]{5}|[*•#]{5})[0-9]{4}\\b",
      "reads": "text"
    },
    {
      "candidates": {
        "span_of": "num"
      },
      "id": "masked",
      "kind": "validator",
      "params": {
        "format": "ssn_us"
      },
      "validator": {
        "id": "masked",
        "version": 1
      }
    },
    {
      "candidates": {
        "span_of": "num"
      },
      "id": "ssn",
      "kind": "validator",
      "params": {},
      "validator": {
        "id": "ssn_us",
        "version": 1
      }
    },
    {
      "anchor": "ssn",
      "fold_fullwidth_ascii": false,
      "id": "cue",
      "ignore_case": true,
      "kind": "proximity",
      "max_distance": 24,
      "phrases": [
        "social security",
        "ssn",
        "taxpayer"
      ],
      "side": "before",
      "unit": "code_points",
      "word_boundary": true
    }
  ],
  "vetoes": [
    {
      "id": "masked_value",
      "removes": [
        "num",
        "ssn"
      ],
      "when": "is_masked"
    }
  ]
