{
  "description": "The SSN dry run end to end, as data (ENH-006, 2026-11-01). RUNBOOK.md reads it stage by stage. Recipes here are what ran, with each run's identifiers replaced by {{placeholders}}; a stage's output fills a later stage's placeholder. Nothing here names the behaviour outside this pack.",
  "placeholders": {
    "definition": "the record dataworks_resolve_behaviour returns",
    "generation_run_id": "this pass 1's carrier run",
    "label_run_id": "the second-opinion run on merged pass 1",
    "slot_hex_alternatives": "every carrier run's slot marker hex, joined with |: read the distinct [[SLOT-XXXXXXXX]] values of the `slot` column of each pass 1 version",
    "pass1_versions": "the pass 1 version of each carrier run",
    "merged_version": "the merged pass 1 version",
    "pass2_version": "the pass 2 version (or its repair)",
    "negatives_version": "the calibration negatives version",
    "plan_version": "a plan's role-column version",
    "calibration_set": "the set built from the labelled queue",
    "train_version": "the training version a probe compared on this set was fitted on; add one exclude_versions entry per such version",
    "owns": "a stack probe's `owns` condition",
    "split_fractions": "a re-split probe's [1 - id_test_share, id_test_share, 0, 0, 0], as a JSON list",
    "everyday_version": "the everyday-numbers version (stage everyday_negatives)",
    "stack_negatives_version": "the stack_negatives version",
    "resplit_version": "a re-split probe's own-positives version"
  },
  "stages": [
    {
      "id": "rule_set",
      "tool": "dataworks_save_rule_set",
      "from": "rule_set.json"
    },
    {
      "id": "templates",
      "tool": "dataworks_save_generation_template",
      "from": "templates.json"
    },
    {
      "id": "index_sources",
      "tool": "dataworks_create_index_source",
      "from": "sizes.json plans (rows, index_start)"
    },
    {
      "id": "plans",
      "tool": "dataworks_build_version",
      "from": "plan.json with sizes.json plans (rows, templated_share, genre_shares, plan_seed)",
      "step": "carrier_plan@1.1.0",
      "note": "@1.1.0 is required: its carrier ids name the plan, so two plans cannot share one whatever their index ranges."
    },
    {
      "id": "role_column",
      "tool": "dataworks_build_version",
      "recipe": {
        "format": "dw.recipe/v1",
        "steps": [
          {
            "operator": "rule_label",
            "params": {
              "output_column": "role",
              "rules": [
                "'the writer’s own US Social Security number. The writer clearly says it is their own Social Security number, so a reader is certain of it' if framing == own_identifier",
                "'the US Social Security number of a named other person (a customer, patient, employee or relative). The text clearly says it is that person’s Social Security number, so a reader is certain of it' if framing == someones_identifier",
                "'an example in a general discussion of Social Security numbers (rules, formats, fraud or policy). It belongs to nobody: never put it in a record, form, field or account, and never say it is anyone’s number' if framing == discussed_in_general",
                "'a note in a Social Security number field saying the number is missing, withheld or kept elsewhere' if framing == naming_no_value",
                "'a different kind of identifier (an employee, account, licence or member number). Never call it a Social Security number and never mention Social Security numbers anywhere in the text' if framing == other_type",
                "'an ordinary number (a reference, a quantity or a code) with no identifier meaning. Never mention Social Security numbers anywhere in the text' if framing == other_number"
              ]
            },
            "version": "1"
          }
        ]
      },
      "note": "A plan and its role column are two builds: the recipe check cannot see carrier_plan's output columns."
    },
    {
      "id": "generation",
      "tool": "dataworks_start_generation",
      "approval": "millm_model_load",
      "args": {
        "mode": "carrier_slot",
        "input_version_id": "{{plan_version}}",
        "prompt_column": "text",
        "seed_splits": [
          "train"
        ],
        "target_type": "detector",
        "behaviour_key": "dlp-ssn-us",
        "rule_sets": "the pin of recipe.json",
        "template_map": "templates.json template_map",
        "generator_model_id": "sizes.json plans",
        "seed": "sizes.json plans generation_seed"
      },
      "per": "plan",
      "note": "One resident model at a time. A deploy of miLLM unloads the model and kills the run: check for running work before any push."
    },
    {
      "id": "pass1",
      "tool": "dataworks_build_version",
      "per": "generation run",
      "recipe": {
        "format": "dw.recipe/v1",
        "steps": [
          {
            "operator": "dw_generated_rows",
            "params": {
              "generation_run_id": "{{generation_run_id}}",
              "target_type": "detector"
            },
            "version": "1"
          },
          {
            "operator": "synth_identifier",
            "params": {
              "delimiters": [
                "none"
              ],
              "output_prefix": "e_pos_none_",
              "scheme": "ssn_us",
              "seed": 1701,
              "valid_share": 1
            },
            "version": "1"
          },
          {
            "operator": "synth_identifier",
            "params": {
              "delimiters": [
                "dash"
              ],
              "output_prefix": "e_pos_dash_",
              "scheme": "ssn_us",
              "seed": 1701,
              "valid_share": 1
            },
            "version": "1"
          },
          {
            "operator": "synth_identifier",
            "params": {
              "delimiters": [
                "space"
              ],
              "output_prefix": "e_pos_space_",
              "scheme": "ssn_us",
              "seed": 1701,
              "valid_share": 1
            },
            "version": "1"
          },
          {
            "operator": "synth_identifier",
            "params": {
              "delimiters": [
                "dot"
              ],
              "output_prefix": "e_pos_dot_",
              "scheme": "ssn_us",
              "seed": 1701,
              "valid_share": 1
            },
            "version": "1"
          },
          {
            "operator": "synth_identifier",
            "params": {
              "delimiters": [
                "none"
              ],
              "output_prefix": "e_masked_none_",
              "perturbations": [
                "masked"
              ],
              "scheme": "ssn_us",
              "seed": 1702,
              "valid_share": 0
            },
            "version": "1"
          },
          {
            "operator": "synth_identifier",
            "params": {
              "delimiters": [
                "dash"
              ],
              "output_prefix": "e_masked_dash_",
              "perturbations": [
                "masked"
              ],
              "scheme": "ssn_us",
              "seed": 1702,
              "valid_share": 0
            },
            "version": "1"
          },
          {
            "operator": "synth_identifier",
            "params": {
              "delimiters": [
                "space"
              ],
              "output_prefix": "e_masked_space_",
              "perturbations": [
                "masked"
              ],
              "scheme": "ssn_us",
              "seed": 1702,
              "valid_share": 0
            },
            "version": "1"
          },
          {
            "operator": "synth_identifier",
            "params": {
              "delimiters": [
                "dot"
              ],
              "output_prefix": "e_masked_dot_",
              "perturbations": [
                "masked"
              ],
              "scheme": "ssn_us",
              "seed": 1702,
              "valid_share": 0
            },
            "version": "1"
          },
          {
            "operator": "synth_identifier",
            "params": {
              "delimiters": [
                "none"
              ],
              "output_prefix": "e_wrong_length_none_",
              "perturbations": [
                "wrong_length"
              ],
              "scheme": "ssn_us",
              "seed": 1703,
              "valid_share": 0,
              "wrong_length_layout": "style"
            },
            "version": "1.1.0"
          },
          {
            "operator": "synth_identifier",
            "params": {
              "delimiters": [
                "dash"
              ],
              "output_prefix": "e_wrong_length_dash_",
              "perturbations": [
                "wrong_length"
              ],
              "scheme": "ssn_us",
              "seed": 1703,
              "valid_share": 0,
              "wrong_length_layout": "style"
            },
            "version": "1.1.0"
          },
          {
            "operator": "synth_identifier",
            "params": {
              "delimiters": [
                "space"
              ],
              "output_prefix": "e_wrong_length_space_",
              "perturbations": [
                "wrong_length"
              ],
              "scheme": "ssn_us",
              "seed": 1703,
              "valid_share": 0,
              "wrong_length_layout": "style"
            },
            "version": "1.1.0"
          },
          {
            "operator": "synth_identifier",
            "params": {
              "delimiters": [
                "dot"
              ],
              "output_prefix": "e_wrong_length_dot_",
              "perturbations": [
                "wrong_length"
              ],
              "scheme": "ssn_us",
              "seed": 1703,
              "valid_share": 0,
              "wrong_length_layout": "style"
            },
            "version": "1.1.0"
          },
          {
            "operator": "synth_identifier",
            "params": {
              "delimiters": [
                "none"
              ],
              "output_prefix": "e_bad_check_none_",
              "perturbations": [
                "bad_range"
              ],
              "scheme": "ssn_us",
              "seed": 1704,
              "valid_share": 0
            },
            "version": "1"
          },
          {
            "operator": "synth_identifier",
            "params": {
              "delimiters": [
                "dash"
              ],
              "output_prefix": "e_bad_check_dash_",
              "perturbations": [
                "bad_range"
              ],
              "scheme": "ssn_us",
              "seed": 1704,
              "valid_share": 0
            },
            "version": "1"
          },
          {
            "operator": "synth_identifier",
            "params": {
              "delimiters": [
                "space"
              ],
              "output_prefix": "e_bad_check_space_",
              "perturbations": [
                "bad_range"
              ],
              "scheme": "ssn_us",
              "seed": 1704,
              "valid_share": 0
            },
            "version": "1"
          },
          {
            "operator": "synth_identifier",
            "params": {
              "delimiters": [
                "dot"
              ],
              "output_prefix": "e_bad_check_dot_",
              "perturbations": [
                "bad_range"
              ],
              "scheme": "ssn_us",
              "seed": 1704,
              "valid_share": 0
            },
            "version": "1"
          },
          {
            "operator": "synth_identifier",
            "params": {
              "delimiters": [
                "none"
              ],
              "output_prefix": "e_glued_letters_none_",
              "perturbations": [
                "adjacent_letters"
              ],
              "scheme": "ssn_us",
              "seed": 1705,
              "valid_share": 0
            },
            "version": "1"
          },
          {
            "operator": "synth_identifier",
            "params": {
              "delimiters": [
                "dash"
              ],
              "output_prefix": "e_glued_letters_dash_",
              "perturbations": [
                "adjacent_letters"
              ],
              "scheme": "ssn_us",
              "seed": 1705,
              "valid_share": 0
            },
            "version": "1"
          },
          {
            "operator": "synth_identifier",
            "params": {
              "delimiters": [
                "space"
              ],
              "output_prefix": "e_glued_letters_space_",
              "perturbations": [
                "adjacent_letters"
              ],
              "scheme": "ssn_us",
              "seed": 1705,
              "valid_share": 0
            },
            "version": "1"
          },
          {
            "operator": "synth_identifier",
            "params": {
              "delimiters": [
                "dot"
              ],
              "output_prefix": "e_glued_letters_dot_",
              "perturbations": [
                "adjacent_letters"
              ],
              "scheme": "ssn_us",
              "seed": 1705,
              "valid_share": 0
            },
            "version": "1"
          },
          {
            "operator": "rule_label",
            "params": {
              "output_column": "e_masked_sibling",
              "rules": [
                "@e_masked_none_value if kind == pos and form in [digits, spaced, spelled, split_lines, mixed_words]",
                "@e_masked_dash_value if kind == pos and form in [digits_dash, prose]",
                "@e_masked_space_value if kind == pos and form in [digits_space]",
                "@e_masked_dot_value if kind == pos and form in [digits_dot]"
              ]
            },
            "version": "1"
          },
          {
            "operator": "rule_label",
            "params": {
              "output_column": "element",
              "rules": [
                "@e_pos_none_value if kind == pos and form in [digits, spaced, spelled, split_lines, mixed_words]",
                "@e_pos_dash_value if kind == pos and form in [digits_dash, prose]",
                "@e_pos_space_value if kind == pos and form in [digits_space]",
                "@e_pos_dot_value if kind == pos and form in [digits_dot]",
                "@e_masked_none_value if kind == masked and form in [digits, spaced, spelled, split_lines, mixed_words]",
                "@e_masked_dash_value if kind == masked and form in [digits_dash, prose]",
                "@e_masked_space_value if kind == masked and form in [digits_space]",
                "@e_masked_dot_value if kind == masked and form in [digits_dot]",
                "@e_wrong_length_none_value if kind == wrong_length and form in [digits, spaced, spelled, split_lines, mixed_words]",
                "@e_wrong_length_dash_value if kind == wrong_length and form in [digits_dash, prose]",
                "@e_wrong_length_space_value if kind == wrong_length and form in [digits_space]",
                "@e_wrong_length_dot_value if kind == wrong_length and form in [digits_dot]",
                "@e_bad_check_none_value if kind == bad_check and form in [digits, spaced, spelled, split_lines, mixed_words]",
                "@e_bad_check_dash_value if kind == bad_check and form in [digits_dash, prose]",
                "@e_bad_check_space_value if kind == bad_check and form in [digits_space]",
                "@e_bad_check_dot_value if kind == bad_check and form in [digits_dot]",
                "@e_glued_letters_none_value if kind == glued_letters and form in [digits, spaced, spelled, split_lines, mixed_words]",
                "@e_glued_letters_dash_value if kind == glued_letters and form in [digits_dash, prose]",
                "@e_glued_letters_space_value if kind == glued_letters and form in [digits_space]",
                "@e_glued_letters_dot_value if kind == glued_letters and form in [digits_dot]"
              ]
            },
            "version": "1"
          },
          {
            "operator": "insert_element",
            "params": {
              "element_column": "element",
              "framing_phrase_share": 0,
              "rule_set_name": "dlp-ssn-us-elements",
              "rule_set_sha256": "73bd179f96a88518cf84bb94d1e7a54f2d2325cb071c7bc7d1bedaaaa0cccfa5",
              "rule_set_version": 2,
              "vocabulary": "@input"
            },
            "version": "1.0.0"
          },
          {
            "operator": "regex_match",
            "params": {
              "column": "text",
              "fold_fullwidth_ascii": false,
              "ignore_case": true,
              "max_spans": 10,
              "output_prefix": "e_leak_",
              "pattern": "own_identifier|someones_identifier|discussed_in_general|naming_no_value|other_type|other_number|\\[\\[SLOT|\\bSLOT[-_: ]?[0-9a-f]{8}\\b|the marker|test corpus|most\\s*imp|important\\s*rule|six roles|only the one above|^\\s*(here is|here.s|sure\\b)"
            },
            "version": "2"
          }
        ]
      },
      "bindings": [
        {
          "kind": "generation_run",
          "id": "{{generation_run_id}}"
        }
      ],
      "inputs": [
        {
          "kind": "version",
          "version_id": "{{plan_version}}"
        }
      ]
    },
    {
      "id": "merged_pass1",
      "tool": "dataworks_build_version",
      "recipe": {
        "format": "dw.recipe/v1",
        "steps": [
          {
            "operator": "empty_content",
            "params": {},
            "version": "1.0.0"
          },
          {
            "operator": "check_carrier_ids",
            "version": "1.0.0",
            "params": {}
          }
        ]
      },
      "seed": 1714,
      "inputs": "{{pass1_versions}}",
      "note": "check_carrier_ids refuses here, before the second opinion is paid for, if two runs' rows share a carrier id they were not planned to share."
    },
    {
      "id": "second_opinion",
      "tool": "dataworks_start_label_run",
      "approval": "paid_classifier_run",
      "args": {
        "input_version_id": "{{merged_version}}",
        "role": "classifier",
        "transport": "single",
        "chunk_size": 200,
        "handoff_id": "ssn-merged-pass1",
        "behaviour_key": "dlp-ssn-us",
        "field_map": {
          "text": "text"
        },
        "positive_label": "yes",
        "negative_label": "no",
        "threshold_positive": 0.5,
        "threshold_negative": 0.49,
        "question": "second_opinion.json questions, the presented question"
      }
    },
    {
      "id": "calibration_labels",
      "tool": "dataworks_create_review_queue",
      "human": true,
      "args": {
        "kind": "calibration_labeling",
        "version_id": "{{merged_version}}",
        "question": "the second_opinion question, exactly",
        "label_set": [
          "yes",
          "no"
        ],
        "size": 300,
        "label_run_id": "{{label_run_id}}",
        "behaviour_key": "dlp-ssn-us"
      },
      "note": "On the merged pass 1, so rows the filter later removes are in the sample: sampling the filtered version would be circular. Only the operator's decisions become human labels. Then dataworks_build_calibration_set and dataworks_compute_calibration; D-7 refuses a send until a record passes."
    },
    {
      "id": "pass2",
      "tool": "dataworks_build_version",
      "recipe": {
        "format": "dw.recipe/v1",
        "steps": [
          {
            "operator": "threshold_labeler",
            "params": {
              "label_run_id": "{{label_run_id}}",
              "threshold_negative": 0.49,
              "threshold_positive": 0.5
            },
            "version": "1"
          },
          {
            "operator": "regex_match",
            "params": {
              "column": "text",
              "fold_fullwidth_ascii": false,
              "ignore_case": true,
              "max_spans": 10,
              "output_prefix": "e_slot_",
              "pattern": "{{slot_hex_alternatives}}"
            },
            "version": "2"
          },
          {
            "operator": "rule_label",
            "params": {
              "output_column": "e_drop",
              "rules": [
                "leak if e_slot_matched == true",
                "leak if e_leak_matched == true",
                "framing if element_recovered == true and kind != naming_no_value and framing in [own_identifier, someones_identifier] and label == negative",
                "framing if element_recovered == true and kind != naming_no_value and framing in [other_number, naming_no_value] and label == positive"
              ]
            },
            "version": "1"
          },
          {
            "operator": "metadata_value_filter",
            "params": {
              "column": "e_drop",
              "values": [
                "leak",
                "framing"
              ]
            },
            "version": "1.0.0"
          },
          {
            "operator": "drop_columns",
            "params": {
              "patterns": [
                "label",
                "label_probability"
              ]
            },
            "version": "1"
          },
          {
            "operator": "slot_siblings",
            "params": {
              "element_column": "element",
              "kinds": [
                "pos"
              ],
              "rule_set_name": "dlp-ssn-us-elements",
              "rule_set_sha256": "73bd179f96a88518cf84bb94d1e7a54f2d2325cb071c7bc7d1bedaaaa0cccfa5",
              "rule_set_version": 2,
              "text_column": "text",
              "variants": "[{\"kind\": \"empty\"}, {\"kind\": \"decoy\", \"ref\": \"lookalike\"}, {\"kind\": \"decoy\", \"ref\": \"naming_no_value\"}, {\"kind\": \"vetoed\", \"ref\": \"masked_value\", \"column\": \"e_masked_sibling\", \"as_kind\": \"masked\"}]",
              "vocabulary": "@input"
            },
            "version": "1.1.0"
          },
          {
            "operator": "rule_label",
            "params": {
              "output_column": "e_sibling_held_out",
              "rules": [
                "drop if sibling_variant is not null and genre in [voice_transcript, ocr_scan]",
                "drop if sibling_variant is not null and generator in [Qwen2.5-7B-Instruct]"
              ]
            },
            "version": "1"
          },
          {
            "operator": "metadata_value_filter",
            "params": {
              "column": "e_sibling_held_out",
              "values": [
                "drop"
              ]
            },
            "version": "1.0.0"
          },
          {
            "operator": "drop_columns",
            "params": {
              "patterns": [
                "e_*"
              ]
            },
            "version": "1"
          },
          {
            "operator": "rule_set",
            "params": {
              "output_prefix": "r_",
              "rule_set_name": "dlp-ssn-us-elements",
              "rule_set_sha256": "73bd179f96a88518cf84bb94d1e7a54f2d2325cb071c7bc7d1bedaaaa0cccfa5",
              "rule_set_version": 2,
              "text_column": "text",
              "use": "label"
            },
            "version": "1"
          },
          {
            "operator": "regex_match",
            "params": {
              "column": "kind",
              "fold_fullwidth_ascii": false,
              "ignore_case": false,
              "max_spans": 1,
              "output_prefix": "e_plan_vetoed_",
              "pattern": "^(masked|wrong_length|bad_check)$"
            },
            "version": "2"
          },
          {
            "operator": "derive_labels",
            "params": {
              "label_column": "disclosure",
              "output_prefix": "r_",
              "rule_set_name": "dlp-ssn-us-elements",
              "rule_set_sha256": "73bd179f96a88518cf84bb94d1e7a54f2d2325cb071c7bc7d1bedaaaa0cccfa5",
              "rule_set_version": 2,
              "scan_column": "r_ssn_spans",
              "target_checks": "[]",
