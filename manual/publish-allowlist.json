  "forbidden": [
    { "name": "internal hostname", "pattern": "hitsai\\.local" },
    { "name": "private IPv4 address", "pattern": "\\b(10\\.\\d{1,3}|192\\.168|172\\.(1[6-9]|2\\d|3[01]))\\.\\d{1,3}\\.\\d{1,3}\\b" },
    { "name": "internal host name", "pattern": "mcs-lnx" },
    { "name": "private planning tree", "pattern": "0xcc/" },
