    { "name": "Hugging Face token", "pattern": "\\bhf_[A-Za-z0-9]{30,}" },
    { "name": "GitHub token", "pattern": "\\b(ghp_|gho_|ghs_|github_pat_)[A-Za-z0-9_]{20,}" },
    { "name": "private key", "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----" },
    { "name": "private runbook", "pattern": "RUNBOOK\\.md" }
